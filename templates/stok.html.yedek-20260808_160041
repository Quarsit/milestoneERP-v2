{% extends "base.html" %}
{% block title %}Depo{% endblock %}

{% block header_right %}
<div class="disa">
  <button class="disa-btn" onclick="disaAc(event, 'stok')" title="Dışa aktar">
    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
      <path d="M12 3v12M8 11l4 4 4-4M4 17v2a2 2 0 002 2h12a2 2 0 002-2v-2"/></svg>
    Dışa Aktar
  </button>
  <div class="disa-menu" id="disaMenu-stok">
    <button onclick="disaAktar('stok','xlsx','tip=' + TIP)"><span style="background:#1D6F42">XLS</span> Excel indir</button>
    <button onclick="disaAktar('stok','pdf','tip=' + TIP)"><span style="background:#B23A2E">PDF</span> PDF indir</button>
  </div>
</div>
{% if menu_admin or menu_yetki.get('stok') == 'yazma' %}
<button class="disa-btn" onclick="topluAc()" title="Excel'den kopyala-yapıştır ile toplu plaka girişi">
  <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
    <path d="M12 21V9M8 13l4-4 4 4M4 5V3a2 2 0 012-2h12a2 2 0 012 2v2"/></svg>
  Toplu İçe Aktar
</button>
<button class="btn-yeni" onclick="yeniAc()">
  <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"><path d="M12 5v14M5 12h14"/></svg>
  Yeni Stok
</button>
{% endif %}
{% endblock %}

{% block head %}
<style>
  .arac-cubugu{display:flex;align-items:center;gap:10px;margin-bottom:14px;flex-wrap:wrap}
  .parcali{display:flex;background:var(--notr-bg);border-radius:var(--r-kucuk);padding:3px}
  .parcali button{border:0;background:transparent;padding:7px 15px;border-radius:6px;font-weight:600;font-size:.84rem;color:var(--soluk)}
  .parcali button.aktif{background:var(--yuzey);color:var(--murekkep);box-shadow:0 1px 3px rgba(0,0,0,.08)}
  .cip{border:1px solid var(--cizgi-koyu);background:var(--yuzey);border-radius:20px;padding:6px 13px;font-size:.8rem;font-weight:500;color:var(--soluk)}
  .cip.aktif{border-color:var(--verde);background:var(--verde-acik);color:var(--verde);font-weight:600}
  .cip-fatura{cursor:pointer}
  .cip-fatura.aktif{border-color:var(--kehribar);background:var(--kehribar-bg);color:var(--kehribar);font-weight:600}
  .fatura-isaret{margin-left:5px;font-size:.85rem;opacity:.8}
  .suz{margin-left:auto;display:flex;gap:8px;align-items:center}
  .suz input{border:1px solid var(--cizgi-koyu);border-radius:var(--r-kucuk);padding:7px 11px;font-family:var(--govde);font-size:.85rem;min-width:210px}
  .suz input:focus{outline:none;border-color:var(--verde);box-shadow:0 0 0 3px var(--verde-acik)}
  tbody tr{cursor:pointer}
  .zaman-cizgi{border-left:2px solid var(--cizgi);margin:6px 0 0 5px;padding-left:16px}
  .zc-madde{position:relative;padding-bottom:14px;font-size:.84rem}
  .zc-madde::before{content:'';position:absolute;left:-21.5px;top:4px;width:9px;height:9px;border-radius:50%;background:var(--cizgi-koyu)}
  .zc-madde.simdi::before{background:var(--verde)}
  .zc-madde .zc-tarih{font-size:.72rem;color:var(--soluk);font-family:var(--mono)}
  .sayfalama{display:flex;align-items:center;gap:10px;justify-content:flex-end;margin-top:14px;font-size:.85rem;color:var(--soluk)}
  .sayfalama button{border:1px solid var(--cizgi-koyu);background:var(--yuzey);border-radius:6px;padding:5px 12px;font-weight:600}
  .sayfalama button:disabled{opacity:.4;cursor:default}
  .modal-ortu{position:fixed;inset:0;background:rgba(25,28,26,.4);display:none;z-index:45;place-items:center;padding:20px}
  .modal-ortu.acik{display:grid}
  .modal{width:720px;max-width:100%;background:var(--yuzey);border-radius:14px;box-shadow:0 24px 70px rgba(25,28,26,.3);overflow:hidden;max-height:92vh;display:flex;flex-direction:column}
  .modal-bas{padding:18px 22px 0}
  .modal-bas h3{font-family:var(--baslik);font-weight:700;font-size:1.15rem}
  .modal-bas p{color:var(--soluk);font-size:.85rem;margin-top:3px}
  .modal-gov{padding:18px 22px;overflow-y:auto}
  .form-satir{display:grid;gap:12px;margin-bottom:12px}
  .f2{grid-template-columns:1fr 1fr} .f3{grid-template-columns:1fr 1fr 1fr} .f4{grid-template-columns:1fr 1fr 1fr 1fr}
  .form-alan label{display:block;font-size:.72rem;font-weight:700;letter-spacing:.04em;text-transform:uppercase;color:var(--soluk);margin-bottom:5px}
  .form-alan input,.form-alan select{width:100%;border:1px solid var(--cizgi-koyu);border-radius:var(--r-kucuk);padding:9px 11px;font-family:var(--govde);font-size:.9rem;background:var(--yuzey)}
  .form-alan input:focus,.form-alan select:focus{outline:none;border-color:var(--verde);box-shadow:0 0 0 3px var(--verde-acik)}
  .form-alan input[readonly]{background:var(--notr-bg);font-family:var(--mono);font-weight:600}
  .onay{display:flex;align-items:center;gap:8px;font-size:.85rem;margin-bottom:12px}
  .onay input{width:auto}
  .modal-alt{padding:14px 22px 20px;display:flex;gap:10px;justify-content:flex-end;border-top:1px solid var(--cizgi)}
  .iptal-btn{border:1px solid var(--cizgi-koyu);background:var(--yuzey);border-radius:var(--r-kucuk);padding:10px 18px;font-weight:600}
  .ozet-kutu{background:var(--notr-bg);border-radius:var(--r-kucuk);padding:12px 14px;display:flex;gap:22px;flex-wrap:wrap;font-size:.85rem}
  .ozet-kutu b{font-family:var(--mono)}

/* ── Toplu içe aktarma sihirbazı ── */
.tp-adim{border:1px solid var(--cizgi);border-radius:var(--r-kucuk);padding:12px 13px;margin-bottom:12px}
.tp-adim-bas{display:flex;align-items:center;gap:8px;font-weight:600;font-size:.9rem;margin-bottom:10px}
.tp-no{display:inline-flex;align-items:center;justify-content:center;width:20px;height:20px;
  border-radius:99px;background:var(--verde);color:#fff;font-size:.72rem;font-weight:700;flex:none}
.tp-eslestir{display:grid;grid-template-columns:repeat(2,1fr);gap:8px 14px}
.tp-cift{display:flex;align-items:center;gap:8px}
.tp-cift label{flex:0 0 42%;font-size:.8rem;font-weight:500}
.tp-cift select{flex:1;min-width:0}
.tp-ozet{display:grid;grid-template-columns:repeat(4,1fr);gap:10px}
.tp-ozet>div{background:var(--notr-bg);border-radius:var(--r-kucuk);padding:9px 11px}
.tp-ozet b{display:block;font-size:.95rem;font-weight:700}
.tp-ozet small{display:block;font-size:.72rem;color:var(--soluk);margin-top:2px}
.tp-not{background:var(--verde-acik);color:var(--verde);border-radius:var(--r-kucuk);
  padding:9px 11px;font-size:.8rem}
.tp-not.tp-uyari{background:var(--kehribar-bg);color:var(--kehribar)}
@media(max-width:760px){.tp-eslestir,.tp-ozet{grid-template-columns:1fr}}
.ek-isaret{font-size:.6rem;color:var(--kehribar);margin-left:3px;vertical-align:super}
</style>
{% endblock %}

{% block content %}
<h1 class="g-baslik">Depo</h1>
<p class="g-alt">Blok, plaka ve ebatlı stoklar. Satıra tıkla — detay, geçmiş ve işlemler sağ panelde açılır.</p>
<svg class="damar" viewBox="0 0 190 10" aria-hidden="true">
  <path d="M0 6 C 25 2, 45 9, 70 5 S 120 1, 150 6 S 180 8, 190 4"/>
  <path class="d2" d="M0 8 C 30 5, 60 10, 95 6 S 160 3, 190 7"/>
</svg>

<div class="kpiler" style="grid-template-columns:repeat(3,1fr)">
  <div class="kpi"><label>Toplam Stok Değeri</label><div class="deger" id="kDeger">—</div><div class="ek" id="kDegerEk">yükleniyor</div></div>
  <div class="kpi"><label>Serbest</label><div class="deger" id="kSerbest">—</div><div class="ek" id="kSerbestEk">satışa hazır</div></div>
  <div class="kpi"><label>Rezerve</label><div class="deger" id="kRezerve">—</div><div class="ek" id="kRezerveEk">siparişe ayrılmış</div></div>
</div>

<div class="arac-cubugu">
  <div class="parcali" id="tipSecim">
    <button class="aktif" data-tip="BLOK">Blok</button>
    <button data-tip="PLAKA">Plaka</button>
    <button data-tip="EBATLI">Ebatlı</button>
  </div>
  <button class="cip aktif" data-durum="">Tümü</button>
  <button class="cip" data-durum="Serbest">Serbest</button>
  <button class="cip" data-durum="Rezerve">Rezerve</button>
  <button class="cip" data-durum="Satildi">Satıldı</button>
  <button class="cip" data-durum="Sevkedildi">Sevk edildi</button>
  <button class="cip" data-durum="Teslim Edildi">Teslim edildi</button>
  <button class="cip" data-durum="Tukendi">Tükendi</button>
  <span style="width:1px;height:20px;background:var(--cizgi-koyu);margin:0 4px;align-self:center"></span>
  <button class="cip cip-fatura" data-fatura="faturasiz" title="Mal geldi, tedarikçi faturası bekleniyor">⏳ Faturasız</button>
  <button class="cip cip-fatura" data-fatura="mal_bekliyor" title="Fatura kesildi, mal henüz gelmedi">📦 Mal bekleniyor</button>
  <div class="suz">
    <input id="ara" placeholder="Cins, blok no, üretici ara…" autocomplete="off">
  </div>
</div>

<div id="secCubuk" style="display:none;align-items:center;gap:10px;margin-bottom:10px;
     padding:8px 12px;background:var(--verde-acik);border-radius:8px;font-size:.85rem">
  <strong><span id="secSayi">0</span> stok seçildi</strong>
  <button class="blok-btn" id="secSilBtn" onclick="secilenleriSil()"
          style="color:var(--kirmizi)">Seçilenleri Sil</button>
</div>
<div style="margin-bottom:8px">
  <button class="disa-btn" id="secKipBtn" onclick="secKipiDegistir()"
          title="Toplu işlem için satır seçimini aç">Seç</button>
</div>
<div class="tablo-kutu">
  <table>
    <thead>
      <tr>
        <th id="secBaslik" style="display:none;width:34px">
          <input type="checkbox" id="secTumu" onclick="secTumunuDegistir(this)"
                 title="Tümünü seç" style="width:15px;height:15px;cursor:pointer"></th>
        <th>Stok</th>
        <th>Cins · Özellik</th>
        <th>Ölçü / Miktar</th>
        <th>Durum</th>
        <th class="sag" title="Yalnızca satın alma / üretim bedeli (ek maliyetler hariç)">Alım/Üretim Maliyeti</th>
        <th class="sag" title="Alım + nakliye, fason, komisyon vb. tüm ek maliyetler dahil">Giydirilmiş Maliyet</th>
        <th class="sag">Toplam</th>
      </tr>
    </thead>
    <tbody id="govde">
      <tr><td colspan="7" class="yukleniyor">Yükleniyor…</td></tr>
    </tbody>
  </table>
</div>
<div class="sayfalama" id="sayfalama"></div>

<!-- Faturalandırma modalı -->
<div class="modal-ortu" id="fatModal" onclick="if(event.target===this)faturalandirKapat()">
  <div class="modal" style="width:480px" role="dialog" aria-label="Faturalandır">
    <div class="modal-bas">
      <h3>Stoğu Faturalandır</h3>
      <p id="fatAlt">—</p>
    </div>
    <div class="modal-gov">
      <div style="background:var(--verde-acik);color:var(--verde);border-radius:var(--r-kucuk);padding:9px 12px;font-size:.8rem;margin-bottom:14px">
        Fatura no girilince <strong>tedarikçi cariye alış faturası borcu</strong> oluşur.
      </div>
      <div class="form-satir f2">
        <div class="form-alan"><label>Fatura No <span style="color:var(--kirmizi)">*</span></label><input id="fatNo" placeholder="AKD-2026-118"></div>
        <div class="form-alan"><label>Alış Tarihi</label><input id="fatTarih" type="date"></div>
      </div>
    </div>
    <div class="modal-alt">
      <button class="iptal-btn" onclick="faturalandirKapat()">Vazgeç</button>
      <button class="btn-yeni" id="fatKaydet" onclick="faturalandirKaydet()">Faturalandır</button>
    </div>
  </div>
</div>

<!-- Maliyet ekleme modalı (stok çekmecesinden açılır) -->
<div class="modal-ortu" id="malModal" onclick="if(event.target===this)maliyetKapat()">
  <div class="modal" style="width:520px" role="dialog" aria-label="Maliyet ekle">
    <div class="modal-bas">
      <h3>Maliyet Ekle</h3>
      <p id="malAlt">—</p>
    </div>
    <div class="modal-gov">
      <div style="background:var(--kagit);border:1px solid var(--cizgi);border-radius:var(--r-kucuk);padding:9px 12px;font-size:.8rem;margin-bottom:14px;color:var(--soluk)">
        Bu tutar stoğun <strong>birim maliyetine</strong> eklenir ve kârlılığa yansır.
        Tedarikçi seçilirse cariye borç yazılır.
      </div>
      <div class="form-satir f2">
        <div class="form-alan"><label>Maliyet Tipi</label>
          <select id="malTip">
            <option>Nakliye (Ocak-Fabrika)</option>
            <option>Gümrük/Liman Masrafı</option>
            <option>Kesim / Fason / Üretim</option>
            <option>Komisyon</option>
            <option>Diğer</option>
          </select>
        </div>
        <div class="form-alan"><label>Fatura No</label>
          <input id="malFaturaNo" data-buyuk-harf="hayir" placeholder="NKL-2026-001"></div>
      </div>
      <div class="form-satir f3">
        <div class="form-alan"><label>Tutar <span style="color:var(--kirmizi)">*</span></label>
          <input id="malTutar" type="number" step="0.01" min="0" placeholder="0"></div>
        <div class="form-alan"><label>Döviz</label>
          <select id="malDoviz"><option>TRY</option><option>USD</option><option>EUR</option></select></div>
        <div class="form-alan"><label>KDV Oranı</label>
          <select id="malKdvSec" onchange="malKdvDegisti()">
            <option value="20" selected>%20 — genel</option>
            <option value="10">%10 — indirimli</option>
            <option value="1">%1</option>
            <option value="0">%0 — istisna</option>
            <option value="diger">Diğer…</option>
          </select>
          <div id="malKdvSerbest" style="display:none;align-items:center;gap:5px;margin-top:6px">
            <input id="malKdv" type="number" step="0.1" min="0" max="100" value="20"
                   data-buyuk-harf="hayir" style="width:78px;text-align:right">
            <span style="color:var(--soluk);font-weight:600">%</span>
          </div></div>
      </div>
      <div class="form-satir f2">
        <div class="form-alan"><label>Tedarikçi (cari)</label>
          <select id="malCari"><option value="">— yok —</option></select></div>
        <div class="form-alan" style="display:flex;align-items:flex-end">
          <label style="display:flex;align-items:center;gap:8px;font-weight:500;cursor:pointer">
            <input id="malKdvDahil" type="checkbox" style="width:16px;height:16px"> Tutar KDV dahil
          </label>
        </div>
      </div>
    </div>
    <div class="modal-alt">
      <button class="iptal-btn" onclick="maliyetKapat()">Vazgeç</button>
      <button class="btn-yeni" id="malKaydet" onclick="maliyetKaydet()">Kaydet</button>
    </div>
  </div>
</div>

<!-- Stok düzenleme modalı -->
<div class="modal-ortu" id="duzModal" onclick="if(event.target===this)duzenleKapat()">
  <div class="modal" style="width:600px" role="dialog" aria-label="Stok düzenle">
    <div class="modal-bas">
      <h3>Stoğu Düzenle</h3>
      <p id="duzAlt">—</p>
    </div>
    <div class="modal-gov">
      <div class="form-satir f2">
        <div class="form-alan"><label>Cins</label><input id="duzCins"></div>
        <div class="form-alan"><label>Yüzey / Özellik</label><input id="duzOzellik"></div>
      </div>
      <div class="form-satir f3">
        <div class="form-alan"><label>Üretici</label>
          <input id="duzUretici" list="dl-ureticiler">
          <datalist id="dl-ureticiler"></datalist>
        </div>
        <div class="form-alan"><label id="duzNoLabel">Blok No</label><input id="duzBlokNo"></div>
        <div class="form-alan"><label>Konum</label><input id="duzKonum" placeholder="Depo 2"></div>
      </div>
      <div class="form-satir f2">
        <div class="form-alan"><label>Durum</label>
          <select id="duzDurum">
            <option>Serbest</option><option>Rezerve</option><option>Satildi</option><option>Hasarlı</option>
          </select>
        </div>
        <div class="form-alan"><label>Alış Fiyatı</label><input id="duzFiyat" type="number" step="0.01"></div>
      </div>
      <div class="form-alan"><label>Açıklama</label>
        <textarea id="duzAciklama" rows="2" placeholder="Stoğa ait notlar" style="width:100%;border:1px solid var(--cizgi-koyu);border-radius:var(--r-kucuk);padding:9px 11px;font-family:var(--govde);font-size:.9rem;resize:vertical"></textarea>
      </div>
    </div>
    <div class="modal-alt">
      <button class="iptal-btn" onclick="duzenleKapat()">Vazgeç</button>
      <button class="btn-yeni" id="duzKaydet" onclick="duzenleKaydet()">Kaydet</button>
    </div>
  </div>
</div>

<!-- Toplu içe aktarma modalı — Excel dosyasından, sayfa ve sütun eşleştirmeli -->
<div class="modal-ortu" id="topluModal" onclick="if(event.target===this)topluKapat()">
  <div class="modal" style="width:960px" role="dialog" aria-label="Toplu içe aktarma">
    <div class="modal-bas">
      <h3>Excel'den Toplu Stok İçe Aktarma</h3>
      <p>Dosyayı seç · sayfayı seç · sütunları eşleştir · ortak bilgileri gir · aktar</p>
    </div>
    <div class="modal-gov">

      <!-- ADIM 1 — DOSYA -->
      <div class="tp-adim">
        <div class="tp-adim-bas"><span class="tp-no">1</span> Excel Dosyası</div>
        <input type="file" id="tDosya" accept=".xlsx,.xlsm" style="display:none"
               onchange="topluDosyaSecildi(this)">
        <div style="display:flex;align-items:center;gap:10px;flex-wrap:wrap">
          <button type="button" class="blok-btn birincil" onclick="document.getElementById('tDosya').click()">
            Dosya Seç…
          </button>
          <span id="tDosyaAd" style="font-size:.84rem;color:var(--soluk)">Henüz dosya seçilmedi</span>
        </div>
      </div>

      <!-- ADIM 2 — SAYFA -->
      <div class="tp-adim" id="tAdimSayfa" style="display:none">
        <div class="tp-adim-bas"><span class="tp-no">2</span> Sayfa (Sheet)</div>
        <div class="form-satir f2">
          <div class="form-alan">
            <label>Dosyadaki sayfa</label>
            <select id="tSayfa" onchange="topluSayfaDegisti()"></select>
          </div>
          <div class="form-alan">
            <label>Ürün Tipi</label>
            <select id="tTip" onchange="topluTipDegisti()">
              <option value="PLAKA">PLAKA</option>
              <option value="BLOK">BLOK</option>
              <option value="EBATLI">EBATLI</option>
            </select>
          </div>
        </div>
      </div>

      <!-- ADIM 3 — SÜTUN EŞLEŞTİRME -->
      <div class="tp-adim" id="tAdimEslestir" style="display:none">
        <div class="tp-adim-bas"><span class="tp-no">3</span> Sütun Eşleştirme</div>
        <p style="font-size:.79rem;color:var(--soluk);margin:-4px 0 10px">
          Soldaki sistem alanı için Excel'deki karşılığını seçin. Yıldızlı alanlar zorunludur.
          Sistem, başlık adlarına bakarak otomatik tahmin yapar.
        </p>
        <div id="tEslestirme" class="tp-eslestir"></div>
      </div>

      <!-- ADIM 4 — ORTAK BİLGİLER -->
      <div class="tp-adim" id="tAdimOrtak" style="display:none">
        <div class="tp-adim-bas"><span class="tp-no">4</span> Tüm Satırlar İçin Ortak Bilgiler</div>
        <div class="form-satir f3">
          <div class="form-alan">
            <label>Tedarikçi / Üretici (cari)</label>
            <select id="tCari" onchange="topluOnizle()"><option value="">— yok —</option></select>
          </div>
          <div class="form-alan"><label>Döviz</label>
            <select id="tDoviz" onchange="topluOnizle()">
              <option>USD</option><option>EUR</option><option>TRY</option>
            </select>
          </div>
          <div class="form-alan"><label>Fiyat Birimi</label>
            <select id="tFiyatBirim" onchange="topluOnizle()">
              <option value="m2">m²</option>
              <option value="sqft">sqft</option>
              <option value="ton">ton</option>
              <option value="m3">m³</option>
            </select>
          </div>
        </div>
        <div class="form-satir f3">
          <div class="form-alan"><label>Alış Tipi</label>
            <select id="tAlisTipi" onchange="topluKdvDurum()">
              <option value="yurtici_kdvli">Yurt içi — KDV'li</option>
              <option value="yurtici_kdvsiz">Yurt içi — KDV'siz</option>
              <option value="ithalat">İthalat</option>
              <option value="istisna">İstisna / Muaf</option>
            </select>
          </div>
          <div class="form-alan"><label>Fatura Durumu</label>
            <select id="tFaturaDurum" onchange="topluOnizle()">
              <option value="faturali">Faturalı — mal + fatura birlikte</option>
              <option value="faturasiz">Faturasız — mal geldi, fatura bekliyor</option>
              <option value="mal_bekliyor">Fatura kesildi, mal bekliyor</option>
            </select>
          </div>
