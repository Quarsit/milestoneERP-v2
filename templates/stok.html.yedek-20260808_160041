function alisTipiDegisti() {
  const kdvli = document.getElementById('sAlisTipi').value === 'yurtici_kdvli';
  document.getElementById('kdvSatir').style.display = kdvli ? '' : 'none';
  if (!kdvli) { document.getElementById('sKdv').value = 0; document.getElementById('sKdvDahil').checked = false; }
  else document.getElementById('sKdv').value = 20;
  hesapla();
}

function hesapla() {
  const t = document.getElementById('sTip').value;
  const boy = parseFloat(document.getElementById('sBoy').value) || 0;
  const yuk = parseFloat(document.getElementById('sYuk').value) || 0;
  const en = parseFloat(document.getElementById('sEn').value) || 0;
  const adet = parseFloat(document.getElementById('sAdet').value) || 1;
  const tonaj = parseFloat(document.getElementById('sTonaj').value) || 0;
  const fiyat = parseFloat(document.getElementById('sFiyat').value) || 0;
  const fb = document.getElementById('sFiyatBirim').value;
  const dov = document.getElementById('sDoviz').value;
  const kdvOran = parseFloat(document.getElementById('sKdv').value) || 0;
  const kdvDahil = document.getElementById('sKdvDahil').checked;

  let olcu = 0, miktar = 0, miktarAd = '';
  if (t === 'BLOK') {
    olcu = (boy * yuk * en) / 1000000;                    // m³
    document.getElementById('sOlcu').value = olcu ? olcu.toFixed(3) + ' m³' : '';
    miktar = fb === 'ton' ? tonaj : olcu;
    miktarAd = fb === 'ton' ? 'ton' : 'm³';
  } else if (t === 'EBATLI') {
    const kasaAdedi = parseInt(document.getElementById('sKasaAdedi').value) || 1;
    const kasaIci = parseInt(document.getElementById('sKasaIci').value) || 1;
    const m2Birim = (boy * yuk) / 10000;                  // tek parça m²
    olcu = m2Birim * kasaIci * kasaAdedi;                 // toplam m² (tüm kasalar)
    document.getElementById('sOlcu').value = olcu ? olcu.toFixed(2) + ' m² · ' + kasaAdedi + ' kasa' : '';
    miktar = fb === 'm2' ? olcu : olcu * 10.7639;         // sqft
    miktarAd = fb === 'm2' ? 'm²' : 'sqft';
  } else {
    const m2Birim = (boy * yuk) / 10000;                  // tek parça m²
    olcu = m2Birim * adet;
    document.getElementById('sOlcu').value = olcu ? olcu.toFixed(2) + ' m²' : '';
    miktar = fb === 'm2' ? olcu : olcu * 10.7639;         // sqft
    miktarAd = fb === 'm2' ? 'm²' : 'sqft';
  }
  // KDV hariç matrah (backend de böyle saklıyor)
  const netFiyat = kdvDahil && kdvOran > 0 ? fiyat / (1 + kdvOran / 100) : fiyat;
  const toplam = netFiyat * miktar;

  document.getElementById('ozMiktar').textContent = miktar ? miktar.toLocaleString('tr-TR', {maximumFractionDigits: 2}) + ' ' + miktarAd : '—';
  document.getElementById('ozBirim').textContent = netFiyat ? para2(netFiyat, dov) + ' /' + miktarAd : '—';
  document.getElementById('ozToplam').textContent = toplam ? para(toplam, dov) + (kdvDahil ? ' (KDV hariç)' : '') : '—';
}

async function stokKaydet() {
  const t = document.getElementById('sTip').value;
  const cins = document.getElementById('sCins').value.trim();
  const fiyat = parseFloat(document.getElementById('sFiyat').value) || 0;
  if (!cins) { bildir('Cins zorunlu.', true); return; }
  if (fiyat <= 0) { bildir('Alış fiyatı girilmeli.', true); return; }
  if (t === 'BLOK' && !(parseFloat(document.getElementById('sTonaj').value) > 0)
      && document.getElementById('sFiyatBirim').value === 'ton') {
    bildir('Tonaj girilmeli (fiyat $/ton).', true); return;
  }
  const btn = document.getElementById('sKaydet');
  btn.disabled = true; btn.textContent = 'Ekleniyor…';
  try {
    const d = await api('/api/stok/ekle', {
      method: 'POST',
      body: JSON.stringify({
        tip: t,
        uretici: document.getElementById('sUretici').value,
        cins,
        blok_no: document.getElementById('sBlokNo').value,
        ozellik: document.getElementById('sOzellik').value,
        boy: parseFloat(document.getElementById('sBoy').value) || 0,
        yukseklik: parseFloat(document.getElementById('sYuk').value) || 0,
        en: t === 'BLOK' ? (parseFloat(document.getElementById('sEn').value) || 0) : 0,
        kalinlik: t !== 'BLOK' ? (parseFloat(document.getElementById('sKal').value) || 0) : 0,
        tonaj: parseFloat(document.getElementById('sTonaj').value) || 0,
        adet: t === 'PLAKA' ? (parseInt(document.getElementById('sAdet').value) || 1) : 1,
        kasa_adedi: t === 'EBATLI' ? (parseInt(document.getElementById('sKasaAdedi').value) || 1) : 1,
        kasa_ici_adet: t === 'EBATLI' ? (parseInt(document.getElementById('sKasaIci').value) || 1) : 1,
        baslangic_no: parseInt(document.getElementById('sBasNo').value) || 1,
        aciklama: document.getElementById('sAciklama').value,
        nakliye_dahil: document.getElementById('sNakliyeDahil').checked,
        fiyat,
        fiyat_birim: document.getElementById('sFiyatBirim').value,
        doviz: document.getElementById('sDoviz').value,
        alis_tipi: document.getElementById('sAlisTipi').value,
        kdv_oran: parseFloat(document.getElementById('sKdv').value) || 0,
        kdv_dahil_mi: document.getElementById('sKdvDahil').checked,
        fatura_durumu: document.getElementById('sFaturaDurum').value,
        fatura_no: document.getElementById('sFaturaNo').value,
        alis_tarihi: document.getElementById('sAlisTarih').value || null,
        giris_tarihi: document.getElementById('sTarih').value || null
      })
    });
    bildir(d.mesaj || 'Stok eklendi');
    modalKapat();
    // Eklenen tipe geç ve tazele
    TIP = t; SAYFA = 1;
    document.querySelectorAll('#tipSecim button').forEach(x => x.classList.toggle('aktif', x.dataset.tip === t));
    await Promise.all([listeyiCiz(), kpiYukle()]);
  } catch (e) { /* api() bildirdi */ }
  finally { btn.disabled = false; btn.textContent = 'Stoğu Ekle'; }
}

/* ═══ TOPLU İÇE AKTARMA (Excel dosyasından) ═══════════════════════════
   AKIŞ
     1) Dosya seç      → POST /api/v2/excel/analiz (salt okuma, DB'ye yazmaz)
     2) Sayfa seç      → aynı dosyanın başka sayfası; yeniden yükleme YOK
     3) Sütun eşleştir → Excel başlıkları ↔ sistem alanları (otomatik tahminli)
     4) Ortak bilgiler → tedarikçi cari, döviz, KDV, fatura, tarihler…
     5) Aktar          → her satır için POST /api/stok

   NEDEN SATIR SATIR /api/stok?
     Tekli girişle BİREBİR aynı muhasebe yolu kullanılsın diye. Böylece
     KDV ayrıştırma (KDV dahil ise fiyat/(1+oran/100)), 'Devreden KDV'
