  document.getElementById('sTip').value = TIP;
  ['sCins','sBlokNo','sOzellik','sBoy','sYuk','sEn','sTonaj','sFiyat','sFaturaNo','sOlcu','sAciklama'].forEach(i => {
    const el = document.getElementById(i); if (el) el.value = '';
  });
  document.getElementById('sAdet').value = 1;
  document.getElementById('sKasaAdedi').value = 1;
  document.getElementById('sKasaIci').value = 1;
  document.getElementById('sBasNo').value = 1;
  document.getElementById('sKal').value = 2;
  document.getElementById('sKdv').value = 20;
  document.getElementById('sKdvDahil').checked = false;
  document.getElementById('sTarih').valueAsDate = new Date();
  document.getElementById('sAlisTarih').valueAsDate = new Date();
  document.getElementById('sFaturaDurum').value = 'faturali';
  faturaDurumDegisti();
  // Üreticiler (ürün tedarikçisi olan cariler)
  if (!URETICILER.length) {
    try {
      const d = await api('/api/cari?per_page=300');
      URETICILER = (d.data || []).filter(cariUreticiMi);   // Tedarikçi + Üretici
    } catch (e) { URETICILER = []; }
  }
  document.getElementById('sUretici').innerHTML = URETICILER.length
    ? URETICILER.map(c => `<option value="${kacar(c.unvan)}">${kacar(c.unvan)}</option>`).join('')
    : '<option value="">— tedarikçi yok, Cari ekranından ekle —</option>';
  tipDegisti();
}
function modalKapat() { document.getElementById('modal').classList.remove('acik'); }

function tipDegisti() {
  const t = document.getElementById('sTip').value;
  const blok = t === 'BLOK', plaka = t === 'PLAKA', ebatli = t === 'EBATLI';
  document.getElementById('enAlan').style.display = blok ? '' : 'none';
  document.getElementById('kalAlan').style.display = blok ? 'none' : '';
  document.getElementById('tonajAlan').style.display = blok ? '' : 'none';
  document.getElementById('adetAlan').style.display = plaka ? '' : 'none';
  document.getElementById('kasaAdediAlan').style.display = ebatli ? '' : 'none';
  document.getElementById('kasaIciAlan').style.display = ebatli ? '' : 'none';
  document.getElementById('basNoAlan').style.display = plaka ? '' : 'none';
  document.getElementById('sNoLabel').textContent = blok ? 'Blok No' : (plaka ? 'Blok No (kesildiği blok)' : 'Kasa No (ilk kasa, ops.)');
  document.getElementById('olcuLabel').textContent = blok ? 'Hacim (m³)' : 'Toplam m²';
  // Fiyat birimi varsayılanı
  const fb = document.getElementById('sFiyatBirim');
  fb.innerHTML = blok
    ? '<option value="ton">$/ton</option><option value="m3">$/m³</option>'
    : '<option value="m2">$/m²</option><option value="sqft">$/sqft</option>';
  hesapla();
}

function faturaDurumDegisti() {
  const d = document.getElementById('sFaturaDurum').value;
  const not = document.getElementById('fdNot');
  const noEl = document.getElementById('sFaturaNo');
  if (d === 'faturasiz') {
    not.style.background = 'var(--kehribar-bg)'; not.style.color = 'var(--kehribar)';
    not.innerHTML = 'Mal geldi ama fatura henüz yok. <strong>Cariye borç işlenmez.</strong> Fatura gelince Depo → stok → "Faturalandır" ile eklersin.';
    noEl.value = ''; noEl.disabled = true; noEl.placeholder = 'fatura gelince girilecek';
  } else if (d === 'mal_bekliyor') {
    not.style.background = 'var(--mavi-bg)'; not.style.color = 'var(--mavi)';
    not.innerHTML = 'Fatura kesildi, <strong>cariye borç işlenir</strong>, ama mal henüz gelmedi. Mal gelince "Mal teslim al" dersin.';
    noEl.disabled = false; noEl.placeholder = 'AKD-2026-118';
  } else {
    not.style.background = 'var(--notr-bg)'; not.style.color = 'var(--soluk)';
