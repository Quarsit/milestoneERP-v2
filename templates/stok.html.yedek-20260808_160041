    ['blok_no',       'Kasa / Referans',  false],
    ['boy',           'Boy (cm)',        true],
    ['yukseklik',     'Yükseklik (cm)',  true],
    ['kalinlik',      'Kalınlık (cm)',   false],
    ['ozellik',       'Yüzey / Özellik', false],
    ['kasa_adedi',    'Kasa Adedi',      false],
    ['kasa_ici_adet', 'Kasa İçi Adet',   false],
    ['fiyat',         'Alış Fiyatı',     false],
    ['aciklama',      'Açıklama',        false],
  ],
};

/* Otomatik eşleştirme için anahtar kelimeler (küçük harf, Türkçe duyarsız) */
const TP_IPUCU = {
  cins: ['cins', 'urun', 'ürün', 'malzeme', 'tas', 'taş', 'material', 'type'],
  blok_no: ['blok', 'block', 'kasa', 'ref', 'parti'],
  boy: ['boy', 'uzunluk', 'length', 'en1'],
  yukseklik: ['yukseklik', 'yükseklik', 'yuk', 'genislik', 'genişlik', 'width', 'height'],
  en: ['en', 'derinlik', 'depth'],
  kalinlik: ['kalinlik', 'kalınlık', 'kal', 'thickness'],
  ozellik: ['yuzey', 'yüzey', 'ozellik', 'özellik', 'finish', 'surface'],
  fiyat: ['fiyat', 'birim', 'price', 'tutar', 'ucret', 'ücret'],
  adet: ['adet', 'miktar', 'qty', 'quantity'],
  tonaj: ['ton', 'tonaj', 'agirlik', 'ağırlık', 'weight'],
  kasa_adedi: ['kasa adedi', 'kasa sayi', 'paket'],
  kasa_ici_adet: ['kasa ici', 'kasa içi', 'ici adet', 'içi adet'],
  aciklama: ['aciklama', 'açıklama', 'not', 'description', 'desc'],
};

function topluAc() {
  document.getElementById('topluModal').classList.add('acik');
  TP_SAYFALAR = []; TP_AKTIF = null; TP_SATIRLAR = [];
  document.getElementById('tDosya').value = '';
  document.getElementById('tDosyaAd').textContent = 'Henüz dosya seçilmedi';
  ['tAdimSayfa', 'tAdimEslestir', 'tAdimOrtak', 'tAdimOnizleme',
   'tIlerleme', 'tSonuc'].forEach(i => document.getElementById(i).style.display = 'none');
  document.getElementById('tKaydet').disabled = true;
  document.getElementById('tTip').value = (TIP || 'PLAKA');
  const bugun = new Date().toISOString().slice(0, 10);
  document.getElementById('tGirisTarih').value = bugun;
  document.getElementById('tAlisTarih').value = bugun;
  document.getElementById('tBaslangicNo').value = '';
  topluTipDegisti();
  topluCarileriYukle();
  topluKdvDurum();
}

function topluKapat() {
  document.getElementById('topluModal').classList.remove('acik');
}

/* Tedarikçi listesi — cari bağlantısı bunun üzerinden kurulur */
async function topluCarileriYukle() {
  const sec = document.getElementById('tCari');
  if (sec.dataset.dolu === '1') return;
  try {
    const d = await api('/api/cari?per_page=300');
    const liste = (d.data || []).filter(c => c.urun_tedarikcisi || /uretici|üretici|tedarik/i.test(c.cari_tip || ''));
    const kaynak = liste.length ? liste : (d.data || []);
    sec.innerHTML = '<option value="">— yok (cari borcu oluşturma) —</option>' +
      kaynak.map(c => `<option value="${kacar(c.unvan)}">${kacar(c.unvan)}</option>`).join('');
    sec.dataset.dolu = '1';
  } catch (e) { /* api() hatayı gösterir */ }
}

/* KDV alanları, alış tipine göre etkin/pasif olur (backend de aynısını zorlar) */
function topluKdvDurum() {
  const kdvli = document.getElementById('tAlisTipi').value === 'yurtici_kdvli';
  document.getElementById('tKdv').disabled = !kdvli;
  document.getElementById('tKdvDahil').disabled = !kdvli;
  const not = document.getElementById('tKdvNot');
  if (kdvli) { not.style.display = 'none'; }
  else {
    not.style.display = 'block';
    not.textContent = 'Bu alış tipinde KDV uygulanmaz — oran 0 kabul edilir.';
  }
  topluOnizle();
}

async function topluDosyaSecildi(inp) {
  const f = inp.files && inp.files[0];
  if (!f) return;
  document.getElementById('tDosyaAd').textContent = f.name + ' — okunuyor…';
  const fd = new FormData();
  fd.append('dosya', f);
  try {
    /* S1: api() sarmalayıcısı kullanılmıyor (multipart yükleme),
       CSRF başlığı ELLE eklenmeli. */
    const r = await fetch('/api/v2/excel/analiz', { method: 'POST', body: fd,
      headers: { 'X-CSRF-Token': window.CSRF_TOKEN } });
    const d = await r.json();
    if (!r.ok || !d.ok) { bildir(d.mesaj || 'Dosya okunamadı.', true); 
      document.getElementById('tDosyaAd').textContent = f.name + ' — okunamadı'; return; }

    TP_SAYFALAR = d.sayfalar || [];
    const toplam = TP_SAYFALAR.reduce((a, s) => a + s.satir_sayisi, 0);
    document.getElementById('tDosyaAd').textContent =
      `${d.dosya_adi} · ${TP_SAYFALAR.length} sayfa · ${toplam} satır`;

    document.getElementById('tSayfa').innerHTML = TP_SAYFALAR
      .map((s, i) => `<option value="${i}">${kacar(s.ad)} (${s.satir_sayisi} satır)</option>`).join('');
    document.getElementById('tAdimSayfa').style.display = '';
    topluSayfaDegisti();
  } catch (e) {
    bildir('Dosya yüklenemedi: ' + e.message, true);
    document.getElementById('tDosyaAd').textContent = f.name + ' — hata';
  }
}

function topluSayfaDegisti() {
  const i = parseInt(document.getElementById('tSayfa').value, 10) || 0;
  TP_AKTIF = TP_SAYFALAR[i] || null;
  topluEslestirmeCiz();
}

function topluTipDegisti() {
  /* Başlangıç plaka no yalnızca PLAKA için anlamlı */
  const alan = document.getElementById('tBaslangicAlan');
  if (alan) alan.style.visibility =
    (document.getElementById('tTip').value === 'PLAKA') ? 'visible' : 'hidden';
  topluEslestirmeCiz();
}

/* Excel başlığı ile sistem alanını isim benzerliğinden tahmin et */
function topluTahmin(alanKod, basliklar) {
  const ipuclari = TP_IPUCU[alanKod] || [];
  const sadelestir = t => String(t || '').toLocaleLowerCase('tr')
    .replace(/[ıİ]/g, 'i').replace(/[şŞ]/g, 's').replace(/[ğĞ]/g, 'g')
    .replace(/[üÜ]/g, 'u').replace(/[öÖ]/g, 'o').replace(/[çÇ]/g, 'c').trim();
  /* Üç aşamalı: önce tam eşleşme, sonra baştan eşleşme, en son içerme.
     Tek aşamada yapılsaydı "Genişlik" başlığı içinde "en" geçtiği için
     En alanına yanlış eşleşebilirdi. */
  const sadeBas = basliklar.map(sadelestir);
  const sadeIp = ipuclari.map(sadelestir);
  for (const kural of ['tam', 'bas', 'icerik']) {
    for (let i = 0; i < sadeBas.length; i++) {
      const b = sadeBas[i];
      if (!b) continue;
      for (const s of sadeIp) {
        if (!s) continue;
        if (kural === 'tam' && b === s) return i;
        if (kural === 'bas' && b.startsWith(s)) return i;
        if (kural === 'icerik' && b.includes(s)) return i;
      }
    }
  }
  return -1;
}

function topluEslestirmeCiz() {
  if (!TP_AKTIF) return;
  const tip = document.getElementById('tTip').value;
  const alanlar = TP_ALANLAR[tip] || TP_ALANLAR.PLAKA;
  const bas = TP_AKTIF.basliklar || [];

  document.getElementById('tEslestirme').innerHTML = alanlar.map(([kod, etiket, zorunlu]) => {
    const tahmin = topluTahmin(kod, bas);
    const secenekler = ['<option value="-1">— eşleştirme —</option>']
      .concat(bas.map((b, i) =>
        `<option value="${i}" ${i === tahmin ? 'selected' : ''}>${kacar(b)}</option>`)).join('');
    return `<div class="tp-cift">
      <label>${kacar(etiket)}${zorunlu ? ' <span style="color:var(--kirmizi)">*</span>' : ''}</label>
      <select data-alan="${kod}" onchange="topluOnizle()">${secenekler}</select>
    </div>`;
  }).join('');

  document.getElementById('tAdimEslestir').style.display = '';
  document.getElementById('tAdimOrtak').style.display = '';
  document.getElementById('tAdimOnizleme').style.display = '';
  topluOnizle();
}

/* Eşleştirmeyi uygula → TP_SATIRLAR üret, önizleme çiz */
function topluOnizle() {
  if (!TP_AKTIF) return;
  const tip = document.getElementById('tTip').value;
  const alanlar = TP_ALANLAR[tip] || TP_ALANLAR.PLAKA;

  const harita = {};
  document.querySelectorAll('#tEslestirme select').forEach(s => {
    const i = parseInt(s.value, 10);
    if (i >= 0) harita[s.dataset.alan] = i;
  });

  const eksikZorunlu = alanlar.filter(([k, , z]) => z && !(k in harita)).map(([, e]) => e);
  const sayi = v => {
    if (v === '' || v === null || v === undefined) return 0;
    const t = String(v).replace(/\s/g, '').replace(',', '.').replace(/[^\d.\-]/g, '');
    const n = parseFloat(t);
    return isFinite(n) ? n : 0;
  };

  TP_SATIRLAR = [];
  const hatalar = [];
  (TP_AKTIF.satirlar || []).forEach((satir, idx) => {
    const al = kod => (kod in harita) ? satir[harita[kod]] : '';
    const kayit = { _satir: idx + 2 };   // +2: başlık satırı + 1 tabanlı
    alanlar.forEach(([kod]) => {
      if (['boy', 'yukseklik', 'en', 'kalinlik', 'fiyat', 'adet', 'tonaj',
           'kasa_adedi', 'kasa_ici_adet'].includes(kod)) kayit[kod] = sayi(al(kod));
      else kayit[kod] = String(al(kod) ?? '').trim();
    });

    if (!kayit.cins) { hatalar.push(`Satır ${kayit._satir}: cins boş`); return; }
    if (!(kayit.boy > 0) || !(kayit.yukseklik > 0)) {
      hatalar.push(`Satır ${kayit._satir}: boy/yükseklik geçersiz`); return;
    }
    if (tip === 'BLOK' && !(kayit.en > 0)) {
      hatalar.push(`Satır ${kayit._satir}: en geçersiz`); return;
    }
    TP_SATIRLAR.push(kayit);
  });

  /* Metraj ve tutar özeti — KDV dahil işaretliyse matrahı ayrıştırarak göster,
     backend de aynı hesabı yapar. */
  const kdvli = document.getElementById('tAlisTipi').value === 'yurtici_kdvli';
  const oran = kdvli ? (parseFloat(document.getElementById('tKdv').value) || 0) : 0;
  const dahil = kdvli && document.getElementById('tKdvDahil').checked;
  const birim = document.getElementById('tFiyatBirim').value;
  const dov = document.getElementById('tDoviz').value;

  let toplamMiktar = 0, toplamMatrah = 0;
  TP_SATIRLAR.forEach(k => {
    let miktar;
    if (tip === 'BLOK') {
      const m3 = (k.boy * k.yukseklik * k.en) / 1000000;
      miktar = (birim === 'ton') ? (k.tonaj || 0) : m3;
    } else {
      const m2 = (k.boy * k.yukseklik) / 10000;
      const adet = tip === 'PLAKA' ? Math.max(1, Math.round(k.adet || 1)) : 1;
      miktar = (birim === 'sqft' ? m2 * 10.7639 : m2) * adet;
    }
    const netFiyat = dahil && oran > 0 ? (k.fiyat || 0) / (1 + oran / 100) : (k.fiyat || 0);
    k._miktar = miktar;
    toplamMiktar += miktar;
    toplamMatrah += netFiyat * miktar;
  });
  const kdvTutar = oran > 0 ? toplamMatrah * oran / 100 : 0;

  const kok = document.getElementById('tOnizleme');
  if (eksikZorunlu.length) {
    kok.innerHTML = `<div class="tp-not tp-uyari">Zorunlu alan eşleştirilmedi: <b>${kacar(eksikZorunlu.join(', '))}</b></div>`;
    document.getElementById('tKaydet').disabled = true;
    return;
  }

  const ilk = TP_SATIRLAR.slice(0, 8);
  const gosterAlan = alanlar.map(([k]) => k).filter(k => k !== 'aciklama');
  kok.innerHTML = `
    <div class="tp-ozet">
      <div><b>${TP_SATIRLAR.length}</b><small>aktarılacak satır</small></div>
      <div><b>${toplamMiktar.toLocaleString('tr-TR', {maximumFractionDigits: 2})}</b><small>toplam ${birim}</small></div>
      <div><b>${toplamMatrah.toLocaleString('tr-TR', {maximumFractionDigits: 2})} ${dov}</b><small>matrah (KDV hariç)</small></div>
      <div><b>${kdvTutar.toLocaleString('tr-TR', {maximumFractionDigits: 2})} ${dov}</b><small>KDV %${oran}</small></div>
    </div>
    ${hatalar.length ? `<div class="tp-not tp-uyari">${hatalar.length} satır atlanacak:<br>${
      kacar(hatalar.slice(0, 6).join(' · '))}${hatalar.length > 6 ? ' …' : ''}</div>` : ''}
    ${TP_SATIRLAR.length ? `<div class="tablo-kutu" style="margin-top:10px">
      <table><thead><tr>${gosterAlan.map(k => {
        const e = alanlar.find(a => a[0] === k); return `<th>${kacar(e ? e[1] : k)}</th>`; }).join('')}</tr></thead>
      <tbody>${ilk.map(k => `<tr>${gosterAlan.map(a => `<td>${kacar(k[a])}</td>`).join('')}</tr>`).join('')}
      </tbody></table></div>
      ${TP_SATIRLAR.length > 8 ? `<div style="font-size:.78rem;color:var(--soluk);margin-top:6px">
        …ve ${TP_SATIRLAR.length - 8} satır daha</div>` : ''}` : ''}`;

  document.getElementById('tKaydet').disabled = TP_SATIRLAR.length === 0;
}

async function topluKaydet() {
  if (!TP_SATIRLAR.length) return;
  const tip = document.getElementById('tTip').value;
  const cari = document.getElementById('tCari').value;
  const faturaDurum = document.getElementById('tFaturaDurum').value;

  let uyari = `${TP_SATIRLAR.length} kayıt ${tip} olarak stoğa eklenecek.`;
  if (cari && faturaDurum !== 'faturasiz') uyari += `\n\n"${cari}" carisine alış borcu oluşturulacak.`;
  else if (!cari) uyari += `\n\nTedarikçi seçilmedi — cari borcu OLUŞMAYACAK.`;
  uyari += '\n\nDevam edilsin mi?';
  if (!confirm(uyari)) return;

  const kdvli = document.getElementById('tAlisTipi').value === 'yurtici_kdvli';
  const ortak = {
    tip: tip,
    uretici: cari,
    doviz: document.getElementById('tDoviz').value,
    fiyat_birim: document.getElementById('tFiyatBirim').value,
    alis_tipi: document.getElementById('tAlisTipi').value,
    fatura_durumu: faturaDurum,
    fatura_no: document.getElementById('tFaturaNo').value.trim(),
    kdv_oran: kdvli ? (parseFloat(document.getElementById('tKdv').value) || 0) : 0,
    kdv_dahil_mi: kdvli && document.getElementById('tKdvDahil').checked,
    giris_tarihi: document.getElementById('tGirisTarih').value || null,
    alis_tarihi: document.getElementById('tAlisTarih').value || null,
  };
  const ortakAciklama = document.getElementById('tAciklama').value.trim();
  const konum = document.getElementById('tKonum').value.trim();

  const btn = document.getElementById('tKaydet');
  btn.disabled = true; btn.textContent = 'Aktarılıyor…';
  document.getElementById('tIlerleme').style.display = '';
  document.getElementById('tSonuc').style.display = 'none';

  /* ── SLAB NUMARALANDIRMA ──
     Her satır ayrı bir POST olduğu için, baslangic_no gönderilmezse
     backend her seferinde 1'den başlar ve tüm plakalar aynı kodu alır
     (K4786#1, K4786#1 …). Doğrusu: aynı blok_no içinde ARDIŞIK numara.

     Başlangıç numarası iki şekilde belirlenir:
       • Kullanıcı "Başlangıç Plaka No" girdiyse → o numaradan başlanır.
         (Dışarıdan alınan bloklarda ilk plakalar alınmamış olabilir;
          örneğin ilk 15 fire ise 16'dan başlanır.)
       • Boş bırakıldıysa → o blokta kayıtlı en büyük numaradan devam edilir. */
  const elleBaslangic = parseInt(document.getElementById('tBaslangicNo').value, 10);
  const baslangicVar = Number.isFinite(elleBaslangic) && elleBaslangic > 0;

  const mevcutMax = {};
  const slabSayac = {};
  if (tip === 'PLAKA' && !baslangicVar) {
    document.getElementById('tIlerlemeYazi').textContent = 'Mevcut plaka numaraları okunuyor…';
    try {
      const mevcut = await api('/api/stok?tip=PLAKA&per_page=1000');
      (mevcut.data || []).forEach(sk => {
        const bn = String(sk.blok_no || '').trim();
        const no = parseInt(sk.slab_no, 10) || 0;
        if (bn) mevcutMax[bn] = Math.max(mevcutMax[bn] || 0, no);
      });
    } catch (e) { /* okunamazsa 1'den başlar — yine ardışık olur */ }
  }

  /** Bir blok için sayacın başlangıç tabanını verir (ilk çağrıda kurar). */
  const slabTaban = (bn) => {
    if (!(bn in slabSayac)) {
      slabSayac[bn] = baslangicVar ? (elleBaslangic - 1) : (mevcutMax[bn] || 0);
    }
    return slabSayac[bn];
  };

  let basarili = 0, hatali = 0;
  const hataListe = [];
  const olusanIdler = [];

  for (let i = 0; i < TP_SATIRLAR.length; i++) {
    const k = TP_SATIRLAR[i];
    const adet = tip === 'PLAKA' ? Math.max(1, Math.round(k.adet || 1)) : 1;

    /* Bu satırın slab numarası: aynı blok içinde kaldığı yerden devam eder */
    let basNo = 1;
    if (tip === 'PLAKA') {
      const bn = String(k.blok_no || '').trim();
      basNo = slabTaban(bn) + 1;
      slabSayac[bn] = basNo + adet - 1;
    }

    const govde = Object.assign({}, ortak, {
      cins: k.cins,
      blok_no: k.blok_no || '',
      boy: k.boy,
      yukseklik: k.yukseklik,
      en: k.en || 0,
      kalinlik: k.kalinlik || 0,
      ozellik: k.ozellik || '',
      tonaj: k.tonaj || 0,
      fiyat: k.fiyat || 0,
      adet: adet,
      baslangic_no: basNo,
      kasa_adedi: k.kasa_adedi || 1,
      kasa_ici_adet: k.kasa_ici_adet || 1,
      aciklama: k.aciklama || ortakAciklama || '',
    });
    try {
      /* DİKKAT: oluşturma uç noktası /api/stok DEĞİL, /api/stok/ekle'dir.
         /api/stok yalnızca GET (listeleme) için tanımlıdır. */
      /* S1: CSRF başlığı — bu çağrı api() sarmalayıcısını kullanmıyor */
      const r = await fetch('/api/stok/ekle', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json',
                   'X-CSRF-Token': window.CSRF_TOKEN },
        body: JSON.stringify(govde),
      });
      let d = null;
      try { d = await r.json(); } catch (e) { d = null; }
      if (r.status === 401) {
        hataListe.push('Oturum düştü — yeniden giriş yapın.');
        hatali += (TP_SATIRLAR.length - i);
        break;
      }
      if (r.ok && d && d.ok) {
        basarili++;
        if (d.id) olusanIdler.push(d.id);
        if (Array.isArray(d.idler)) olusanIdler.push(...d.idler);
      } else {
        hatali++;
        /* Yanıt JSON değilse (404/405/500 → HTML sayfa) durum kodunu göster;
           yoksa hata teşhis edilemez hale gelir. */
        const neden = (d && (d.mesaj || d.error)) || `sunucu ${r.status} döndü`;
        hataListe.push(`Satır ${k._satir}: ${neden}`);
      }
    } catch (e) {
      hatali++;
      hataListe.push(`Satır ${k._satir}: ${e.message}`);
    }

    const yuzde = Math.round(((i + 1) / TP_SATIRLAR.length) * 100);
    document.getElementById('tIlerlemeCubuk').style.width = yuzde + '%';
    document.getElementById('tIlerlemeYazi').textContent =
      `${i + 1} / ${TP_SATIRLAR.length} · başarılı ${basarili} · hatalı ${hatali}`;
  }

  /* Konum: POST /api/stok bu alanı almıyor, PUT /api/stok/<id> alıyor. */
  if (konum && olusanIdler.length) {
    document.getElementById('tIlerlemeYazi').textContent = 'Konum bilgisi yazılıyor…';
    for (const id of olusanIdler) {
      try {
        /* S1: CSRF başlığı — api() sarmalayıcısı kullanılmıyor */
        await fetch('/api/stok/' + encodeURIComponent(id), {
          method: 'PUT',
          headers: { 'Content-Type': 'application/json',
                     'X-CSRF-Token': window.CSRF_TOKEN },
          body: JSON.stringify({ konum: konum }),
        });
      } catch (e) { /* konum ikincil — sessiz geç */ }
    }
  }

  const sonuc = document.getElementById('tSonuc');
  sonuc.style.display = '';
  sonuc.innerHTML = `<div class="tp-not ${hatali ? 'tp-uyari' : ''}">
    <b>${basarili} kayıt aktarıldı${hatali ? `, ${hatali} satır hatalı` : ''}.</b>
    ${hataListe.length ? `<div style="margin-top:6px;font-size:.78rem">${
      kacar(hataListe.slice(0, 10).join(' · '))}${hataListe.length > 10 ? ' …' : ''}</div>` : ''}
    ${cari && faturaDurum !== 'faturasiz' && basarili
      ? `<div style="margin-top:6px;font-size:.78rem">"${kacar(cari)}" carisine alış borcu işlendi.</div>` : ''}
  </div>`;

  btn.textContent = 'İçe Aktar';
  btn.disabled = true;
  bildir(`${basarili} kayıt içe aktarıldı`, hatali > 0);

  TIP = tip; SAYFA = 1;
  document.querySelectorAll('#tipSecim button').forEach(x => x.classList.toggle('aktif', x.dataset.tip === tip));
  await Promise.all([listeyiCiz(), kpiYukle()]);
}

/* ═══ FATURALANDIRMA / MAL TESLİM / DÜZENLE / SİL ═══
   POST   /api/stok/<tip>/<id>/faturalandir {fatura_no, alis_tarihi}
          → faturasız stoğa fatura atar, tedarikçi cariye ALIŞ borcu oluşturur
   POST   /api/stok/<tip>/<id>/mal_teslim {giris_tarihi}
          → faturası kesilmiş ama gelmemiş malı teslim alındı işaretler
   PUT    /api/stok/<id>            → alan güncelleme
   DELETE /api/stok/<tip>/<id>      → silme (sadece Serbest) */

let FAT_STOK = null, DUZ_STOK = null;

function faturalandirAc(id, tip, cins) {
  FAT_STOK = { id, tip };
  cekmeceKapat();
  document.getElementById('fatAlt').textContent = `${cins || ''} · ${id}`;
  document.getElementById('fatNo').value = '';
  document.getElementById('fatTarih').valueAsDate = new Date();
  document.getElementById('fatModal').classList.add('acik');
}
function faturalandirKapat() { document.getElementById('fatModal').classList.remove('acik'); }

async function faturalandirKaydet() {
  const no = document.getElementById('fatNo').value.trim();
  if (!no) { bildir('Fatura no zorunlu.', true); return; }
  const btn = document.getElementById('fatKaydet');
  btn.disabled = true; btn.textContent = 'İşleniyor…';
  try {
    const d = await api(`/api/stok/${encodeURIComponent(FAT_STOK.tip)}/${encodeURIComponent(FAT_STOK.id)}/faturalandir`, {
      method: 'POST',
      body: JSON.stringify({
        fatura_no: no,
        alis_tarihi: document.getElementById('fatTarih').value || null
      })
    });
    bildir(d.mesaj || 'Stok faturalandırıldı · ' + no);
    faturalandirKapat();
    await Promise.all([listeyiCiz(), kpiYukle()]);
  } catch (e) { /* */ }
  finally { btn.disabled = false; btn.textContent = 'Faturalandır'; }
}

async function malTeslimAl(id, tip) {
  if (!confirm('Mal teslim alındı olarak işaretlensin mi? (Borç zaten oluşmuştu, sadece stok girişi yapılır.)')) return;
  try {
    const d = await api(`/api/stok/${encodeURIComponent(tip)}/${encodeURIComponent(id)}/mal_teslim`, {
      method: 'POST',
      body: JSON.stringify({ giris_tarihi: new Date().toISOString().slice(0, 10) })
    });
    bildir(d.mesaj || 'Mal teslim alındı');
    cekmeceKapat();
    await Promise.all([listeyiCiz(), kpiYukle()]);
  } catch (e) { /* */ }
}

function duzenleAc(id) {
  const s = (SON.data || []).find(x => x.id === id);
  if (!s) return;
  DUZ_STOK = s;
  cekmeceKapat();
  document.getElementById('duzAlt').textContent = `${s.id} · ${s.tip}`;
  document.getElementById('duzCins').value = s.cins || '';
  document.getElementById('duzOzellik').value = s.ozellik || '';
  document.getElementById('duzUretici').value = s.uretici || '';
  document.getElementById('duzBlokNo').value = s.blok_no || s.kasa_no || '';
  document.getElementById('duzKonum').value = s.konum || '';
  document.getElementById('duzDurum').value = s.durum || 'Serbest';
  document.getElementById('duzFiyat').value = s.alis_fiyati || '';
  document.getElementById('duzAciklama').value = s.aciklama || '';
  document.getElementById('duzNoLabel').textContent = s.tip === 'EBATLI' ? 'Kasa No' : 'Blok No';
  listeyeBagla('duzCins', 'cins');
  listeyeBagla('duzOzellik', 'ozellik');
  ureticiOnerileriDoldur();
  document.getElementById('duzModal').classList.add('acik');
}
function duzenleKapat() { document.getElementById('duzModal').classList.remove('acik'); }

/* Üretici önerileri — Cari'deki Tedarikçi/Üretici kayıtlarından */
async function ureticiOnerileriDoldur() {
  if (!URETICILER.length) {
    try {
      const d = await api('/api/cari?per_page=300');
      URETICILER = (d.data || []).filter(cariUreticiMi);
    } catch (e) { URETICILER = []; }
  }
  const dl = document.getElementById('dl-ureticiler');
  if (dl) dl.innerHTML = URETICILER.map(c => `<option value="${kacar(c.unvan)}">`).join('');
}

async function duzenleKaydet() {
  const btn = document.getElementById('duzKaydet');
  btn.disabled = true; btn.textContent = 'Kaydediliyor…';
  try {
    const d = await api(`/api/stok/${encodeURIComponent(DUZ_STOK.id)}`, {
      method: 'PUT',
      body: JSON.stringify({
        tip: DUZ_STOK.tip,
        cins: document.getElementById('duzCins').value,
        ozellik: document.getElementById('duzOzellik').value,
        uretici: document.getElementById('duzUretici').value,
        blok_no: document.getElementById('duzBlokNo').value,
        kasa_no: document.getElementById('duzBlokNo').value,
        konum: document.getElementById('duzKonum').value,
        durum: document.getElementById('duzDurum').value,
        alis_fiyati: parseFloat(document.getElementById('duzFiyat').value) || null,
        aciklama: document.getElementById('duzAciklama').value
      })
    });
    bildir(d.mesaj || 'Stok güncellendi');
    duzenleKapat();
    await Promise.all([listeyiCiz(), kpiYukle()]);
  } catch (e) { /* */ }
  finally { btn.disabled = false; btn.textContent = 'Kaydet'; }
}

/* ═══ KESİME GÖNDER ═══
   BLOK  → hedef sorulur (plaka mı, ebatlı mı) → /kesim?kaynak=<id>&yon=BLOK_PLAKA|BLOK_EBATLI
   PLAKA → tek yön var → /kesim?kaynak=<id>&yon=PLAKA_EBATLI
   Kesim ekranı kaynağı otomatik seçer ve cins/yüzey bilgilerini doldurur. */
function kesimeGonder(id, tip) {
  if (tip === 'PLAKA') {
    location.href = `/kesim?kaynak=${encodeURIComponent(id)}&yon=PLAKA_EBATLI`;
    return;
  }
  // BLOK → hedef tipi sor
  const s = (SON.data || []).find(x => x.id === id);
  cekmeceAc(
    'Kesim hedefi',
    `${(s && s.cins) || ''} · ${id}`,
    `<p style="font-size:.9rem;color:var(--soluk);margin-bottom:16px">
       Bu blok neye kesilecek? Seçimine göre kesim formu hazır açılır.
     </p>
     <div style="display:grid;gap:10px">
       <button class="blok-btn birincil" style="text-align:left;padding:14px"
               onclick="location.href='/kesim?kaynak=${encodeURIComponent(id)}&yon=BLOK_PLAKA'">
         <strong style="display:block;font-size:.95rem">Plakaya kes</strong>
         <small style="color:rgba(255,255,255,.75)">Blok → dilimlenmiş plakalar (m²)</small>
       </button>
       <button class="blok-btn" style="text-align:left;padding:14px"
               onclick="location.href='/kesim?kaynak=${encodeURIComponent(id)}&yon=BLOK_EBATLI'">
         <strong style="display:block;font-size:.95rem">Ebatlıya kes</strong>
         <small style="color:var(--soluk)">Blok → ölçülü ebatlı ürün (kasa)</small>
       </button>
     </div>`,
    `<button class="blok-btn" onclick="cekmeceKapat()">Vazgeç</button>`
  );
}

async function stokSil(id, tip, no) {
  const ad = no || id;
  if (!confirm(`${ad} silinsin mi?\n\nBu stoğa ait maliyet kayıtları ve cari hareketler de temizlenir. Bu işlem geri alınamaz.`)) return;
  try {
    const d = await api(`/api/stok/${encodeURIComponent(tip)}/${encodeURIComponent(id)}`, { method: 'DELETE' });
    bildir(d.mesaj || 'Stok silindi');
    cekmeceKapat();
    await Promise.all([listeyiCiz(), kpiYukle()]);
  } catch (e) { /* */ }
}

/* ═══ MALİYET EKLE (stok çekmecesinden) ═══
   Kullanıcı maliyetler sayfasına gitmeden, açık olan stoğa doğrudan
   maliyet ekleyebilsin. Stok zaten seçili gelir. */
let MAL_STOK = null;
/* Maliyet KDV oranı: hazır seçim veya serbest giriş */
function malKdvDegisti() {
  const sec = document.getElementById('malKdvSec');
  const kutu = document.getElementById('malKdvSerbest');
  const inp = document.getElementById('malKdv');
  if (sec.value === 'diger') { kutu.style.display = 'flex'; inp.focus(); inp.select(); }
  else { kutu.style.display = 'none'; inp.value = sec.value; }
}
function malKdvOraniAl() {
  const sec = document.getElementById('malKdvSec');
  if (!sec) return 0;
  return sec.value === 'diger'
    ? (parseFloat(document.getElementById('malKdv').value) || 0)
    : (parseFloat(sec.value) || 0);
}
async function maliyetAc(id, tip, no, cins) {
  MAL_STOK = { id, tip };
  document.getElementById('malAlt').textContent =
    `${no || id}${cins ? ' · ' + cins : ''} · ${tip}`;
  document.getElementById('malTutar').value = '';
  document.getElementById('malFaturaNo').value = '';
  document.getElementById('malKdvSec').value = '20';
  document.getElementById('malKdv').value = 20;
  document.getElementById('malKdvSerbest').style.display = 'none';
  document.getElementById('malKdvDahil').checked = false;
  document.getElementById('malDoviz').value = 'TRY';
  document.getElementById('malModal').classList.add('acik');
  // Tedarikçi listesini doldur (bir kez)
  const sec = document.getElementById('malCari');
  if (sec.options.length <= 1) {
    try {
      const d = await api('/api/cari?per_page=300');
      (d.data || []).forEach(c => {
        const o = document.createElement('option');
        o.value = c.id; o.textContent = c.unvan;
        sec.appendChild(o);
      });
    } catch (e) { /* cari yetkisi yoksa boş kalır */ }
  }
  setTimeout(() => document.getElementById('malTutar').focus(), 60);
}
function maliyetKapat() {
  document.getElementById('malModal').classList.remove('acik');
  MAL_STOK = null;
}
async function maliyetKaydet() {
  if (!MAL_STOK) return;
  const tutar = parseFloat(document.getElementById('malTutar').value);
  if (!tutar || tutar <= 0) { bildir('Geçerli bir tutar gir.', true); return; }
  const btn = document.getElementById('malKaydet');
  btn.disabled = true; btn.textContent = 'Kaydediliyor…';
  try {
    const d = await api('/api/maliyet', {
      method: 'POST',
      body: JSON.stringify({
        maliyet_tip: document.getElementById('malTip').value,
        baglanti_tip: 'stok',
        baglanti_id: MAL_STOK.id,
        tutar,
        doviz: document.getElementById('malDoviz').value,
        kdv_oran: malKdvOraniAl(),
        kdv_dahil_mi: document.getElementById('malKdvDahil').checked,
        fatura_no: document.getElementById('malFaturaNo').value,
        cari_id: document.getElementById('malCari').value || null
      })
    });
    bildir(d.mesaj || 'Maliyet eklendi');
    const _id = MAL_STOK.id;
    maliyetKapat();
    await listeyiCiz();
    detayAc(_id);          // çekmeceyi tazele — yeni maliyet görünsün
  } catch (e) { /* hata api() içinde gösterilir */ }
  finally { btn.disabled = false; btn.textContent = 'Kaydet'; }
}

kpiYukle();
listeyiCiz();
</script>
{% endblock %}
