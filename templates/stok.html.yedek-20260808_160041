{% block scripts %}
<script>
/* ═══ NAKLİYE DAHİL İŞARETİ ═══
   Yalnızca bilgi amaçlıdır: maliyet, birim maliyet ve kârlılık
   hesaplarını ETKİLEMEZ. İşaretlenince açıklamaya standart bir not
   düşer (elle silinebilir) ve bayrak kayda geçer; böylece ileride
   "nakliye dahil alınanlar" diye süzülebilir.
   Nakliyeyi gerçekten maliyete giydirmek için Maliyet modülünden
   ek maliyet kalemi girilir. */
const NAKLIYE_NOT = 'Alış fiyatına nakliye dahildir.';

function nakliyeNotu() {
  const kutu = document.getElementById('sNakliyeDahil');
  const alan = document.getElementById('sAciklama');
  if (!kutu || !alan) return;
  const mevcut = (alan.value || '').trim();
  if (kutu.checked) {
    if (!mevcut.includes(NAKLIYE_NOT)) {
      alan.value = mevcut ? mevcut + ' ' + NAKLIYE_NOT : NAKLIYE_NOT;
    }
  } else {
    alan.value = mevcut.replace(NAKLIYE_NOT, '').replace(/\s{2,}/g, ' ').trim();
  }
}

/* ═══ DEPO ═══
   /api/stok?tip=BLOK|PLAKA|EBATLI&durum=&page= → {data:[…], meta:{page,per_page,total}}
   Satır tıklama → /api/stok/<id>/gecmis ile zaman çizgisi + duruma göre işlemler.
   Sunucuda serbest-metin araması yok; sayfadaki kayıtlar üzerinde anlık süzülür. */

let TIP = 'BLOK', DURUM = '', FATURA_DURUM = '', SAYFA = 1, ARA = '';
let SON = { data: [], meta: {} };

/** Saf ALIM/ÜRETİM birim maliyeti (USD, ek maliyetler HARİÇ).
 *
 *  Backend iki değeri de veriyor:
 *    toplam_maliyet_usd = alım bedeli + ek maliyetler (nakliye, fason, komisyon…)
 *    ek_maliyet_toplam  = yalnızca ek maliyetler
 *  Farkları saf alım bedelidir; temel ölçüye bölünce birim maliyet çıkar.
 *  Temel ölçü: BLOK → ton, PLAKA/EBATLI → m².
 *
 *  NOT: birim_maliyet_usd zaten GİYDİRİLMİŞ maliyettir. Ek maliyet
 *  girilmemişse ikisi eşit görünür — bu doğrudur, hata değildir. */
function alimBirim(x) {
  if (!x) return 0;
  const toplam = x.toplam_maliyet_usd || 0;
  const ek = x.ek_maliyet_toplam || 0;
  const olcu = (x.tip === 'BLOK') ? (x.tonaj || 0) : (x.m2 || x.metraj_m2 || 0);
  if (!olcu) return 0;
  return (toplam - ek) / olcu;
}

const RAY = { 'Serbest':'ray-yesil', 'Rezerve':'ray-kehribar', 'Satildi':'ray-mavi',
              'Satıldı':'ray-mavi', 'Sevkedildi':'ray-mavi', 'Teslim Edildi':'ray-gri',
              'Teslim':'ray-gri', 'Tukendi':'ray-gri', 'Kesildi':'ray-mavi', 'Hasarlı':'ray-kirmizi' };
const ROZET = { 'Serbest':'rz-yesil', 'Rezerve':'rz-kehribar', 'Satildi':'rz-mavi',
                'Satıldı':'rz-mavi', 'Sevkedildi':'rz-mavi', 'Teslim Edildi':'rz-gri',
                'Teslim':'rz-gri', 'Tukendi':'rz-gri', 'Kesildi':'rz-mavi', 'Hasarlı':'rz-kirmizi' };
// Durum → okunur etiket (Türkçe gösterim)
const DURUM_AD = { 'Serbest':'Serbest', 'Rezerve':'Rezerve', 'Satildi':'Satıldı',
                   'Sevkedildi':'Sevk edildi', 'Teslim Edildi':'Teslim edildi',
                   'Tukendi':'Tükendi (kesildi)', 'Hasarlı':'Hasarlı' };
/* Kullanıcıya gösterilecek anlamlı stok numarası.
   Sistem ID'leri (BLK-xxx) rastgele kombinasyonlardır, akılda tutulamaz —
   bunun yerine blok no / kasa no / slab no gösterilir. ID arka planda kalır. */
function stokNo(x) {
  if (!x) return '—';
  if (x.tip === 'EBATLI') return x.kasa_no || x.blok_no || x.id;
  if (x.tip === 'PLAKA')  return x.slab_no ? `${x.blok_no || ''}#${x.slab_no}`.replace(/^#/, '')
                                           : (x.blok_no || x.id);
  return x.blok_no || x.id;
}
const RENK = { 'ray-yesil':'--verde', 'ray-kehribar':'--kehribar', 'ray-mavi':'--mavi',
               'ray-gri':'--cizgi-koyu', 'ray-kirmizi':'--kirmizi' };

function olcu(s) {
  if (s.tip === 'BLOK') {
    const ol = (s.boy && s.yukseklik && s.en) ? `${s.boy}×${s.yukseklik}×${s.en}` : null;
    const tn = s.tonaj ? s.tonaj.toLocaleString('tr-TR') + ' ton' : null;
    return [ol, tn].filter(Boolean).join(' · ') || '—';
  }
  const ol = `${s.boy || '?'}×${s.yukseklik || '?'}`;
  const kl = s.kalinlik ? s.kalinlik + ' cm' : null;
  const m2 = s.m2 ? s.m2.toLocaleString('tr-TR') + ' m²' : null;
  return [ol, kl, m2].filter(Boolean).join(' · ');
}

async function listeyiCiz() {
  const govde = document.getElementById('govde');
  govde.innerHTML = '<tr><td colspan="7" class="yukleniyor">Yükleniyor…</td></tr>';
  try {
    const q = new URLSearchParams({ tip: TIP, page: SAYFA, per_page: 50 });
    if (DURUM) q.set('durum', DURUM);
    if (FATURA_DURUM) q.set('fatura_durumu', FATURA_DURUM);
    SON = await api('/api/stok?' + q);
  } catch (e) {
    govde.innerHTML = '<tr><td colspan="7" class="bos">Stok verisi alınamadı.</td></tr>';
    document.getElementById('sayfalama').innerHTML = '';
    return;
  }
  const s = ARA.toLocaleLowerCase('tr');
  const satirlar = (SON.data || []).filter(x => !s ||
    [x.cins, x.blok_no, x.uretici, x.id, x.ozellik, x.konum]
      .filter(Boolean).join(' ').toLocaleLowerCase('tr').includes(s));

  if (!satirlar.length) {
    govde.innerHTML = `<tr><td colspan="7" class="bos">${ARA ? 'Aramaya uyan kayıt yok.' : 'Bu filtrede stok yok.'}</td></tr>`;
  } else {
    govde.innerHTML = satirlar.map(x => {
      const r = RAY[x.durum] || 'ray-gri';
      return `
      <tr class="${r}" style="border-left-color:var(${RENK[r]})" onclick="${SECIM_KIPI ? `secDegistir('${kacar(x.id)}')` : `detayAc('${kacar(x.id)}')`}">
        <td style="${SECIM_KIPI ? '' : 'display:none'}"><input type="checkbox" class="sec-kutu"
             data-id="${kacar(x.id)}" ${SECILENLER.has(x.id) ? 'checked' : ''}
             onclick="event.stopPropagation();secDegistir('${kacar(x.id)}')"
             style="width:15px;height:15px;cursor:pointer"></td>
        <td><span class="mono">${kacar(stokNo(x))}</span>${
              x.konum ? '<div class="ikincil">' + kacar(x.konum) + '</div>' : ''}</td>
        <td>${kacar(x.cins || '—')}<div class="ikincil">${kacar(x.ozellik || x.uretici || '')}</div></td>
        <td class="mono" style="font-size:.8rem">${kacar(olcu(x))}</td>
        <td><span class="rozet ${ROZET[x.durum] || 'rz-gri'}">${kacar(DURUM_AD[x.durum] || x.durum || '—')}</span>${
          x.fatura_durumu === 'faturasiz' ? '<span class="fatura-isaret" title="Tedarikçi faturası bekleniyor">⏳</span>'
          : (x.fatura_durumu === 'mal_bekliyor' ? '<span class="fatura-isaret" title="Mal bekleniyor">📦</span>' : '')
        }</td>
        <td class="sag mono">${(() => { const a = alimBirim(x); return a ? para2(a) + '/' + (x.birim_ad || '') : '—'; })()}</td>
        <td class="sag mono">${x.birim_maliyet_usd
          ? para2(x.birim_maliyet_usd) + '/' + (x.birim_ad || '') +
            ((x.ek_maliyet_toplam || 0) > 0 ? '<span class="ek-isaret" title="Ek maliyet giydirilmiş">▲</span>' : '')
          : '—'}</td>
        <td class="sag mono" style="font-weight:600">${x.toplam_maliyet_usd ? para(x.toplam_maliyet_usd) : '—'}</td>
      </tr>`;
    }).join('');
  }

  const m = SON.meta || {};
  const sonSayfa = Math.max(1, Math.ceil((m.total || 0) / (m.per_page || 50)));
  document.getElementById('sayfalama').innerHTML = (m.total || 0) > (m.per_page || 50)
    ? `<button onclick="sayfaGit(${SAYFA - 1})" ${SAYFA <= 1 ? 'disabled' : ''}>← Önceki</button>
       <span>Sayfa ${SAYFA} / ${sonSayfa} · ${m.total} kayıt</span>
       <button onclick="sayfaGit(${SAYFA + 1})" ${SAYFA >= sonSayfa ? 'disabled' : ''}>Sonraki →</button>`
    : `<span>${m.total || 0} kayıt</span>`;
}
function sayfaGit(n) { SAYFA = n; listeyiCiz(); window.scrollTo({ top: 0, behavior: 'smooth' }); }

async function kpiYukle() {
  try {
    const d = await api('/api/rapor/stok_durum');
    const t = d.tip_ozet || {}, du = d.durum_ozet || {};
    document.getElementById('kDeger').innerHTML = para(d.toplam_deger_usd || 0).replace(' $', '<small>$</small>');
    document.getElementById('kDegerEk').textContent =
      Object.keys(t).map(k => t[k].adet + ' ' + k.toLowerCase()).join(' · ') || 'stok yok';
    const ser = du['Serbest'] || { adet: 0, deger_usd: 0 };
    const rez = du['Rezerve'] || { adet: 0, deger_usd: 0 };
    document.getElementById('kSerbest').textContent = ser.adet;
    document.getElementById('kSerbestEk').textContent = para(ser.deger_usd) + ' · satışa hazır';
    document.getElementById('kRezerve').textContent = rez.adet;
    document.getElementById('kRezerveEk').textContent = para(rez.deger_usd) + ' · siparişe ayrılmış';
  } catch (e) { /* yetkisizse sessiz */ }
}

/* ═══ SEÇİM KİPİ — TOPLU SİLME (T1) ═══
   Stok yalnızca tek tek silinebiliyordu: satır → çekmece → Sil →
   onay → kapat → sonraki. Toplu içe aktarma varken toplu silme
   olmaması asimetriydi.
   Kip açıkken satır tıklaması çekmece yerine SEÇİM yapar. */
let SECIM_KIPI = false;
const SECILENLER = new Set();

function secKipiDegistir() {
  SECIM_KIPI = !SECIM_KIPI;
  if (!SECIM_KIPI) SECILENLER.clear();
  const bas = document.getElementById('secBaslik');
  if (bas) bas.style.display = SECIM_KIPI ? '' : 'none';
  const btn = document.getElementById('secKipBtn');
  if (btn) btn.textContent = SECIM_KIPI ? 'Seçimi Bırak' : 'Seç';
  ciz();
  secDurumGuncelle();
}

function secDegistir(id) {
  if (!SECIM_KIPI) return;
  if (SECILENLER.has(id)) SECILENLER.delete(id); else SECILENLER.add(id);
  document.querySelectorAll('.sec-kutu').forEach(k => {
    k.checked = SECILENLER.has(k.dataset.id);
  });
  secDurumGuncelle();
}

function secTumunuDegistir(kutu) {
  document.querySelectorAll('.sec-kutu').forEach(k => {
    k.checked = kutu.checked;
    if (kutu.checked) SECILENLER.add(k.dataset.id); else SECILENLER.delete(k.dataset.id);
  });
  secDurumGuncelle();
}

function secDurumGuncelle() {
  const c = document.getElementById('secCubuk');
  if (!c) return;
  c.style.display = (SECIM_KIPI && SECILENLER.size) ? 'flex' : 'none';
  const s = document.getElementById('secSayi');
  if (s) s.textContent = SECILENLER.size;
}

async function secilenleriSil() {
  const idler = [...SECILENLER];
  if (!idler.length) return;
  if (!confirm(`${idler.length} stok SİLİNECEK.\n\n` +
      `Rezerve, satılmış, kesime girmiş veya borcu kapatılmış stoklar ` +
      `atlanır ve sebebi bildirilir.\n\nDevam edilsin mi?`)) return;
  const btn = document.getElementById('secSilBtn');
  if (btn) { btn.disabled = true; btn.textContent = 'Siliniyor…'; }
  try {
    const d = await api('/api/stok/toplu_sil', {
      method: 'POST', body: JSON.stringify({ tip: TIP, stok_idler: idler })
    });
    bildir(d.mesaj || `${d.silinen} stok silindi`, (d.atlanan || 0) > 0);
    if (d.atlanan_detay && d.atlanan_detay.length) {
      /* Atlananları kullanıcıya GÖSTER — sessizce yutmak, "sildim
         sandım ama duruyor" durumuna yol açar. */
      alert('SİLİNEMEYENLER:\n\n' + d.atlanan_detay
        .map(x => `• ${x.stok_id}: ${x.sebep}`).join('\n'));
    }
    SECILENLER.clear();
    await yukle();
    secDurumGuncelle();
  } catch (e) { /* api() zaten bildiriyor */ }
  finally { if (btn) { btn.disabled = false; btn.textContent = 'Seçilenleri Sil'; } }
}

async function detayAc(id) {
  const s = (SON.data || []).find(x => x.id === id);
  if (!s) return;
  const alan = (l, d, mono) => `<div class="alan"><label>${l}</label><div class="${mono ? 'mono' : ''}">${d || '—'}</div></div>`;
  // Alış birim fiyatı: maliyetler GİYDİRİLMEMİŞ ham alım fiyatı (kendi dövizinde).
  // "Birim Maliyet" ise ek maliyetler dahil edilmiş hali (USD) — ikisi ayrı bilgi.
  const alisBirim = s.alis_fiyati
    ? para2(s.alis_fiyati, s.doviz || 'USD') + ' / ' + (s.fiyat_birim || '')
    : '—';
  const govde = `
    <div class="alan-grid">
      ${alan('Durum', `<span class="rozet ${ROZET[s.durum] || 'rz-gri'}">${kacar(DURUM_AD[s.durum] || s.durum || '—')}</span>`)}
      ${alan('Konum', kacar(s.konum || '—'))}
      ${alan('Ölçü / Miktar', kacar(olcu(s)), true)}
      ${alan('Alış Fiyatı', alisBirim, true)}
      ${alan('Ek Maliyet', s.ek_maliyet_toplam ? para(s.ek_maliyet_toplam) : '—', true)}
      ${alan('Alım/Üretim Maliyeti', alimBirim(s) ? para2(alimBirim(s)) + ' / ' + (s.birim_ad || '') : '—')}
      ${alan('Ek Maliyetler', (s.ek_maliyet_toplam || 0) > 0 ? para(s.ek_maliyet_toplam) : '—')}
      ${alan('Giydirilmiş Maliyet', s.birim_maliyet_usd ? para2(s.birim_maliyet_usd) + ' / ' + (s.birim_ad || '') : '—', true)}
      ${alan('Toplam Maliyet', s.toplam_maliyet_usd ? para(s.toplam_maliyet_usd) : '—', true)}
      ${alan('Üretici', kacar(s.uretici || '—'))}
      ${alan('Fatura No', s.fatura_durumu === 'faturasiz'
          ? '<span class="rozet rz-kehribar">Faturasız — fatura bekliyor</span>'
          : (s.fatura_durumu === 'mal_bekliyor'
            ? '<span class="rozet rz-mavi">Mal bekleniyor</span>'
            : kacar(s.fatura_no || 'Faturalı')))}
      ${alan('Giriş Tarihi', kacar(s.giris_tarihi || '—'), true)}
      ${s.ozellik ? alan('Yüzey', kacar(s.ozellik)) : ''}
      ${s.aciklama ? alan('Açıklama', kacar(s.aciklama)) : ''}
    </div>
    <h4 style="font-size:.8rem;font-weight:700;letter-spacing:.05em;text-transform:uppercase;color:var(--soluk);margin-bottom:10px">Geçmiş</h4>
    <div id="gecmis"><div class="yukleniyor" style="padding:10px 0">Yükleniyor…</div></div>`;

  const eylem = [];
  // Fatura durumu akışları:
  //   faturasiz    → mal geldi, fatura yok  → Faturalandır (tedarikçiye borç oluşur)
  //   mal_bekliyor → fatura var, mal yok    → Mal teslim al
  if (s.fatura_durumu === 'faturasiz' && yazabilir('stok'))
    eylem.push(`<button class="blok-btn birincil" onclick="faturalandirAc('${kacar(s.id)}','${kacar(s.tip)}','${kacar(s.cins || '')}')">Faturalandır</button>`);
  if (s.fatura_durumu === 'mal_bekliyor' && yazabilir('stok'))
    eylem.push(`<button class="blok-btn birincil" onclick="malTeslimAl('${kacar(s.id)}','${kacar(s.tip)}')">Mal teslim al</button>`);
  if (s.durum === 'Serbest' && yazabilir('rezervasyon'))
    eylem.push(`<button class="blok-btn ${s.fatura_durumu === 'faturasiz' ? '' : 'birincil'}" onclick="rezerveEt('${kacar(s.id)}','${kacar(s.tip)}')">Rezerve et</button>`);
  if (s.durum === 'Serbest' && s.tip !== 'EBATLI' && yazabilir('kesim'))
    eylem.push(`<button class="blok-btn" onclick="kesimeGonder('${kacar(s.id)}','${kacar(s.tip)}')">${s.tip === 'BLOK' ? 'Kesime gönder' : 'Ebatlıya kes'}</button>`);
  if (yazabilir('stok'))
    eylem.push(`<button class="blok-btn" onclick="duzenleAc('${kacar(s.id)}')">Düzenle</button>`);
  // Maliyet ekle — maliyetler sayfasına gitmeden, bu stoğa doğrudan
  if (yazabilir('maliyet'))
    eylem.push(`<button class="blok-btn" onclick="maliyetAc('${kacar(s.id)}','${kacar(s.tip)}','${kacar(stokNo(s))}','${kacar(s.cins || '')}')">Maliyet ekle</button>`);
  if (s.durum === 'Serbest' && yazabilir('stok'))
    eylem.push(`<button class="blok-btn" style="color:var(--kirmizi)" onclick="stokSil('${kacar(s.id)}','${kacar(s.tip)}','${kacar(stokNo(s))}')">Sil</button>`);
  eylem.push(`<button class="blok-btn" onclick="cekmeceKapat()">Kapat</button>`);

  cekmeceAc(s.cins || stokNo(s), `${stokNo(s)} · ${s.tip}`, govde, eylem.join(''));

  try {
    const g = await api(`/api/stok/${encodeURIComponent(id)}/gecmis`);
    const olaylar = g.olaylar || [];
    const el = document.getElementById('gecmis');
    if (!el) return;
    el.innerHTML = olaylar.length
      ? `<div class="zaman-cizgi">${olaylar.map((o, i) => `
          <div class="zc-madde ${i === 0 ? 'simdi' : ''}">
            <div class="zc-tarih">${kacar(o.tarih || '')}</div>
            <strong>${kacar(o.baslik || '')}</strong>
            ${o.aciklama ? '<div style="color:var(--soluk);font-size:.8rem;margin-top:2px">' + kacar(o.aciklama) + '</div>' : ''}
          </div>`).join('')}</div>`
      : '<div class="bos" style="padding:12px">Hareket kaydı yok.</div>';
  } catch (e) {
    const el = document.getElementById('gecmis');
    if (el) el.innerHTML = '<div class="bos" style="padding:12px">Geçmiş alınamadı.</div>';
  }
}

