/* ═══ YENİ STOK ═══
   POST /api/stok/ekle {tip, uretici, cins, blok_no, ozellik, boy, yukseklik, en,
                        kalinlik, tonaj, adet, baslangic_no, fiyat, fiyat_birim,
                        doviz, kdv_oran, kdv_dahil_mi, alis_tipi, fatura_no, giris_tarihi}
   BLOK  → tek kayıt (boy×yükseklik×en → m³; tonaj ayrı)
   PLAKA → 'adet' kadar ayrı kayıt (slab no'ları baslangic_no'dan artar)
   EBATLI→ kasa kaydı (boy×yükseklik×kalınlık) */

let URETICILER = [];

async function yeniAc() {
  document.getElementById('sNakliyeDahil').checked = false;
  // Cins/yüzey alanları Ayarlar > Listeler'den beslenir, girilen değer BÜYÜK HARF olur
