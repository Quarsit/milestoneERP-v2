# ══════════════════════════════════════════════════════════════
#  Milestone ERP — ORTAM DEĞİŞKENLERİ ŞABLONU
#
#  Bu dosya ÖRNEKTİR, depoda durur ve gerçek değer İÇERMEZ.
#  Yeni bir kurulumda kopyalayıp doldurun:
#
#      cp .env.ornek .env
#      nano .env
#
#  .env dosyası .gitignore ile dışlanmıştır — ASLA depoya gönderilmez.
# ══════════════════════════════════════════════════════════════

# ── VERİTABANI  (ZORUNLU) ─────────────────────────────────────
# Ayarlanmazsa uygulama SQLite'a düşer ve instance/milestone.db
# yaratır (flask_app.py:213). O durumda PostgreSQL'deki gerçek
# verinize DEĞİL, boş bir dosyaya yazar — sessiz bir hata.
DATABASE_URL=postgresql://kullanici:sifre@localhost/milestone_v2

# ── OTURUM ANAHTARI  (ZORUNLU) ────────────────────────────────
# Oturum çerezlerini ve CSRF token'larını imzalar.
# Ayarlanmazsa kod sabit bir geliştirme anahtarına düşer ve
# günlüğe uyarı yazar. O anahtar herkese açık depoda yazılı
# olduğu için saldırgan kendi oturum çerezini üretip ADMIN
# olarak girebilir.
#
# Rastgele değer üretmek için:
#     python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=buraya-64-karakterlik-rastgele-deger

# ── ÇALIŞMA ORTAMI ────────────────────────────────────────────
# 'uretim' yazılırsa SESSION_COOKIE_SECURE açılır: oturum çerezi
# YALNIZCA HTTPS üzerinden gönderilir (flask_app.py:45).
#
# DİKKAT: Sisteme hem https://<makine>.ts.net hem de
# http://<tailscale-ip>:8002 üzerinden erişiyorsanız BOŞ BIRAKIN —
# aksi halde HTTP üzerinden giriş yapılamaz (çerez gönderilmez).
# Yalnızca HTTPS kullanıyorsanız 'uretim' yazın.
ORTAM=

# ── GELİŞTİRME  (isteğe bağlı) ────────────────────────────────
# FLASK_DEBUG=1 hata ayıklama kipini açar. ÜRETİMDE KULLANMAYIN:
# hata sayfalarında kod ve değişken içerikleri görünür.
FLASK_DEBUG=0

# Uygulamanın dinlediği kapı (varsayılan 5000; systemd 8002 kullanıyor)
PORT=8002

# ── NOT: MILESTONE_ACILIS_ATLA ────────────────────────────────
# Bu değişken .env'e YAZILMAZ. Yalnızca şema göçü komutlarında
# geçici olarak kullanılır (goc.py kendisi ayarlar). Açılış
# işlerini (db.create_all, seed, TCMB kur çekme) atlar; Alembic
# uygulamayı içe aktarırken çökmesini önler.
